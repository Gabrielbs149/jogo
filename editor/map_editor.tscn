text = "Refazer"

[node name="Sep1" type="VSeparator" parent="UI/Root/TopBar/Row"]
layout_mode = 2

[node name="LevelProps" type="Button" parent="UI/Root/TopBar/Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Nome, abertura, textos de vitória e derrota, sol, céu e neblina"
text = "Fase e céu"

[node name="TopView" type="Button" parent="UI/Root/TopBar/Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Câmera bem de cima, como uma planta (T)"
text = "De cima"

[node name="Snap" type="CheckButton" parent="UI/Root/TopBar/Row"]
unique_name_in_owner = true
layout_mode = 2
