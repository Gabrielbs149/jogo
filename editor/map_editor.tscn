[node name="Row" type="HBoxContainer" parent="UI/Root/TopBar"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LevelPick" type="OptionButton" parent="UI/Root/TopBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
tooltip_text = "Fase aberta"

[node name="Save" type="Button" parent="UI/Root/TopBar/Row"]
unique_name_in_owner = true
layout_mode = 2
