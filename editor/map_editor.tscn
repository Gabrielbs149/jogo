[gd_scene format=3]

[ext_resource type="Script" path="res://editor/map_editor.gd" id="editor"]
[ext_resource type="Script" path="res://editor/editor_camera.gd" id="camera"]
[ext_resource type="Theme" path="res://ui/theme/journey_theme.tres" id="theme"]

[sub_resource type="StyleBoxFlat" id="Panel"]
bg_color = Color(0.09, 0.07, 0.06, 0.9)
border_color = Color(0.55, 0.36, 0.2, 0.8)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 8.0
content_margin_top = 6.0
content_margin_right = 8.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="Box"]
bg_color = Color(1, 0.82, 0.3, 0.12)
border_color = Color(1, 0.82, 0.3, 0.9)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1

[node name="MapEditor" type="Node3D"]
script = ExtResource("editor")

[node name="World" type="Node3D" parent="."]
process_mode = 4

[node name="Camera" type="Node3D" parent="."]
script = ExtResource("camera")

[node name="Overlay" type="Node3D" parent="."]
process_mode = 4

[node name="Lines" type="MeshInstance3D" parent="Overlay"]
cast_shadow = 0

[node name="UI" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("theme")

[node name="TopBar" type="PanelContainer" parent="UI/Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = 50.0
grow_horizontal = 2
