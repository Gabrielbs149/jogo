text = "Grade"

[node name="Sep2" type="VSeparator" parent="UI/Root/TopBar/Row"]
layout_mode = 2

[node name="Test" type="Button" parent="UI/Root/TopBar/Row"]
unique_name_in_owner = true
layout_mode = 2
