{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File tools/check.ps1:*)",
      "mcp__godot__get_godot_version",
      "mcp__godot__get_project_info",
      "mcp__godot__list_projects",
      "mcp__godot__get_debug_output",
      "mcp__godot__run_project",
      "mcp__godot__stop_project",
      "mcp__godot__launch_editor",
      "mcp__godot__get_uid"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase -i:*)",
      "Read(./.godot/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "skillsmith": {
      "source": {
        "source": "github",
        "repo": "jame581/skillsmith"
      }
    }
  },
  "enabledPlugins": {
    "godot-prompter@skillsmith": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "git fetch --quiet; git status -sb; git log -5 --format=\"%h %an (%ar): %s\" origin/main"
          }
        ]
      }
    ]
  }
}
