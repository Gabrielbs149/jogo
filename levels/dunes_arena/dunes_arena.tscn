[node name="DunesArena" type="Node3D"]
script = ExtResource("1_r")
chapter_title = "Ruínas de Ethera"
intro_lines = PackedStringArray("Há seis meses, cinco desconhecidos perderam suas sombras no mesmo dia.", "Recuperaram. E descobriram que eram os heróis de uma profecia antiga.", "No Plano do Fogo, as estrelas se voltaram contra eles. Agora o grupo caça os Astros, um por um.", "Caiaque, Umu e Juca esperam do outro lado das dunas.", "Mas antes há Ethera, onde um guardião ainda protege um selo que já não existe.")
victory_text = "O Último Guardião descansa.
Ethera pode descansar também.
Caiaque, Umu e Juca vão querer ouvir essa história."
defeat_text = "O vento cobre os passos de vocês.
Esta noite, as estrelas brilham um pouco mais."

