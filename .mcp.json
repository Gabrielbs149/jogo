{
  "mcpServers": {
    "godot": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@coding-solo/godot-mcp@0.1.1"],
      "env": {
        "GODOT_PATH": "${GODOT:-}"
      }
    },
    "blender": {
      "command": "cmd",
      "args": ["/c", "uvx", "mcp-for-blender"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
